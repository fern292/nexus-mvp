# ============================================
# Nexus MVP — Production Environment Template
# ============================================
# Copy this file to .env.local and fill in values.
# DO NOT commit .env.local to version control.

# ── Database ──────────────────────────────────
# PostgreSQL connection string.
# For Vercel Postgres: automatically set by Vercel.
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres?pgbouncer=true
# For self-hosted: postgresql://user:password@host:5432/dbname?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus?pgbouncer=true"

# ── NextAuth ─────────────────────────────────
# Generate a random secret: openssl rand -hex 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ── WalletConnect ────────────────────────────
# Get your project ID from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ── Enjin API ────────────────────────────────
ENJIN_API_URL="https://platform.canary.enjin.io/graphql"
# Optional: Enjin API key for higher rate limits
ENJIN_API_KEY=""

# ── Price Data (CoinGecko) ──────────────────
# Free tier works fine. Pro API key optional.
COINGECKO_API_KEY=""

# ── Notifications ────────────────────────────
# Resend (https://resend.com) — for email alerts
RESEND_API_KEY=""
# Optional: From email for Resend
RESEND_FROM="alerts@yourdomain.com"

# Discord webhook URL for Discord alerts
DISCORD_WEBHOOK_URL=""

# ── App Config ──────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nexus Portfolio"
